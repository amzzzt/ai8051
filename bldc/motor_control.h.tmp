//===================================================================================================================
//                                            电机控制模块
//-------------------------------------------------------------------------------------------------------------------
//  本文件定义：
//    1. motor_struct   —�? 电机的全部运行时状态（全局唯一实例 motor�?
//    2. run_state_enum —�? 电机状态机的状态枚�?
//    3. 电机控制的对外接口函�?
//
//  实现文件：motor_control.c（换相中�? / 比较器中�? / 堵转看门�? / 上电鸣叫�?
//  状态机主体：pit_timer.c �? pit_motor_control()，由 TM1_Isr �? 50us 调用一�?
//===================================================================================================================


//-------------------------------------------------------------------------------------------------------------------
//  电机运行时状态结构体
//-------------------------------------------------------------------------------------------------------------------
//  ⚠️ 本结构体的字段会被多个中断同时读写（TM0/TM1/TM4/比较�?/PWMB），
//     新增字段时如果要跨中断共享，需自行考虑原子性（251 �? uint32 的读写不是原子的）�?
//-------------------------------------------------------------------------------------------------------------------
typedef struct
{
    vuint8   step;                   			// 电机运行的步�?
    											// 取值范�? 0~5，对应六步换相的 6 个状态�?
    											// 每换一次相 +1，到 6 自动回绕�? 0（见 motor_next_step）�?
    											// 同时被用来决定比较器检测的是上升沿还是下降沿（step % 2）�?

    uint16  duty;                   			// PWM占空�?       用户改变电机速度时修改此变量
    											// 【目标值】应用层只应该改这个变量�?
    											// �? signal_input.c 的输入捕获中断根据油门信号写入�?
    											// 取值范�? 0 ~ BLDC_PWM_ARR_MAX(923)�?
    											// �? 0 表示油门归零，状态机会回�? MOTOR_IDLE�?

    uint16  duty_register;          			// PWM占空比寄存器 用户不可操作
    											// 【当前值】实际写�? PWM 比较寄存器的占空比�?
    											// 闭环状态下由加减速斜坡逻辑缓慢逼近 duty，实现平滑变速�?
    											// ⚠️ 不要直接修改它来调速，会绕过加减速斜坡导致电流冲击�?

    vuint8  run_flag;               			// 电机正在运行标志�? 0:已停�? 1：正在启�? 2：切入闭环之后再维持一段运行时�? 3：启动完成正在运�?
    											// ⚠️ 上面的注释是历史遗留，实际取值是 run_state_enum 里的 7 个状态�?
    											// 状态机�? pit_timer.c �? pit_motor_control() 中推进�?

    float   motor_start_delay;      			// 开环启动的换相的延时时�?
    uint16  motor_start_wait;       			// 开环启动时，换相时间已经降低到最小值后，统计换相的次数
    uint16  restart_delay;          			// 电机延时重启
    											// 堵转停机后倒计时（单位 50us），归零后回�? MOTOR_IDLE 允许再次启动�?
    											// 初�? = BLDC_START_DELAY�?

    uint16  commutation_failed_num; 			// 换相错误次数
    											// 闭环下每次换相耗时超出合理区间�? +1，正常则 -1�?
    											// 超过 BLDC_COMMUTATION_FAILED_MAX 判定为堵转�?
    											// �?"加减�?"而非纯累加，是为了容忍偶发抖动�?

    uint16  commutation_time[6];    			// 最�?6次换相时�?
    											// 【滑动窗口】保存最�? 6 步的换相耗时，正好覆盖一个完整电周期�?
    											// 每步换相时用新值覆盖最旧的那个（索引就�? motor.step）�?

    uint32  commutation_time_sum;   			// 最�?6次换相时间总和
    											// 即一个完整电周期的时间。换相时�?"减最旧、加最�?"的增量更新�?
    											// ⚠️ �? uint32，在 251 上非原子，跨中断读写要注意�?

    uint32  commutation_num;        			// 统计换相次数
    											// 用于两个判据�?
    											//   > BLDC_OPEN_LOOP_WAIT  �? 开环切闭环
    											//   > BLDC_CLOSE_LOOP_WAIT �? 开始换相错误判定和加减速斜�?

    uint32  filter_commutation_time_sum;        // 滤波后的换相时间
    											// commutation_time_sum 经一阶低通滤波后的值，用于抗抖动�?
    											// 闭环系数 7:1，开环系�? 3:1（见各中断里的实现）�?
    											// 【换相计时和进角延时都以它为准】即无感换相的核心依据�?
}motor_struct;


//-------------------------------------------------------------------------------------------------------------------
//  电机状态机状态枚�?
//-------------------------------------------------------------------------------------------------------------------
//  状态迁移图�?
//
//                    motor.duty != 0
//     ┌─────────�?  ────────────────────────�?  ┌──────────────�?
//     │MOTOR_IDLE�?                            �? MOTOR_START  �?
//     └─────────�?  ◄────────────────────────  └──────────────�?
//          �?           重启延时结束                  �?
//          �?                                   正弦强拉/开环延�?
//          �?                                        �?
//          �?                                 ┌──────────────�?
//          �?                                 │MOTOR_OPEN_LOOP�?
//          �?                                 └──────────────�?
//          �?                                        �? commutation_num > BLDC_OPEN_LOOP_WAIT
//          �?                                        �?
//          �?                                 ┌──────────────�?
//          �?                                 │MOTOR_CLOSE_LOOP�?
//          �?                                 └──────────────�?
//          �?              堵转/换相失败过多        �?
//          �?                                 ┌──────────────�?
//          �?                                 │MOTOR_STOP_STALL�?
//          �?                                 └──────────────�?
//          �?                                        �?
//          �?                                 ┌──────────────�?
//          └─────────────────────────────────�? MOTOR_RESTART�?
//                                              └──────────────�?
//
//     任意状态下检测到电池欠压 ──�? BYTE_LOW_VOLTAGE（最高优先级，锁死不再启动）
//-------------------------------------------------------------------------------------------------------------------
typedef enum
{
    MOTOR_IDLE = 0,         // 空闲待机：无油门输入，电机停转。LED 慢闪�?
                            // 收到非零油门后转�? MOTOR_START�?

    MOTOR_START,            // 启动：关闭所有中�? �? 打开全部 PWM 通道 �? 正弦强拉一�?
                            //        （或纯开环延时）�? 初始化换相时间缓�? �? 首次换相
                            //        �? 转入 MOTOR_OPEN_LOOP�?
                            // ⚠️ 正弦强拉是在中断里跑阻塞循环，会长时间占�? TM1 中断�?

    MOTOR_OPEN_LOOP,        // 开环运行：不依赖比较器，靠轮询比较器输出电平跳变来换相�?
                            // 目的只是把转速拉起来，让反电动势足够强能被检测到�?
                            // 完成 BLDC_OPEN_LOOP_WAIT 次换相后打开比较器中断，转入闭环�?

    MOTOR_CLOSE_LOOP ,      // 闭环运行：由比较器中断触发换相（真正的无感换相）�?
                            // 同时执行堵转检测和占空比加减速斜坡�?

    MOTOR_STOP_STALL,       // 堵转停机：执�? motor_stop()，关闭比较器和定时器4中断�?
                            // 然后转入 MOTOR_RESTART 开始倒计时�?

    MOTOR_RESTART,          // 堵转后等待重启：倒计�? BLDC_START_DELAY�?500ms），
                            // 归零后回�? MOTOR_IDLE，于是可以再次尝试启动�?
                            // LED 快闪表示处于此状态�?

    BYTE_LOW_VOLTAGE,       // 电池欠压保护：最高优先级状态�?
                            // 一旦进入就关闭所有输出并锁死，即使电压恢复也不会自动退�?
                            // （需要重新上电）。LED �? ERR 常亮�?

}run_state_enum;


//-------------------------------------------------------------------------------------------------------------------
//  全局电机状态实�?
//-------------------------------------------------------------------------------------------------------------------
extern  motor_struct motor;


//-------------------------------------------------------------------------------------------------------------------
//  对外接口
//-------------------------------------------------------------------------------------------------------------------

// 上电鸣叫：用电机线圈当喇叭播放一段音阶，表示初始化完成�?
// 参数 volume：音�? 0~100（内部会�? 100 的上限保护）�?
void motor_power_on_beep(uint16 volume);

// 电动机停止：占空比清�? + 关闭 PWM 输出 + 关闭比较器中断�?
void motor_stop(void);

// 电机初始化：三相 PWM 引脚配置、状态变量清零、T0/T4 定时器配置、中断优先级设置�?
// ⚠️ 必须�? pwm_out_init() 之前调用（见 main.c 里的顺序警告）�?
void motor_init(void);

// 打开换相中断（声明保留，当前实现中未见调用点）�?
void motor_commutation_isr_open(void);

// 换相步进：motor.step 自增，超�? 5 回绕�? 0�?
void motor_next_step(void);
